# ─────────────────────────────────────────────────────────────────
# StudyMate AI — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and configure values for your environment.
# Values marked [REQUIRED] must be supplied before starting.
# Values marked [OPTIONAL] fall back to sensible defaults.
# NEVER commit your production .env file to source control!
# ─────────────────────────────────────────────────────────────────

# ── Application & Environment ────────────────────────────────────
# [OPTIONAL] Application display name
APP_NAME="StudyMate RAG"

# [OPTIONAL] Environment: "development" | "staging" | "production"
# In "production", startup guards reject SQLite, local storage, insecure JWT secrets, etc.
ENVIRONMENT=development

# [OPTIONAL] Debug mode (enables verbose errors; MUST be false in production)
DEBUG=false


# ── Database & Migrations (Neon Serverless Postgres / SQLite) ────
# [OPTIONAL] Database connection string.
# Local Development: SQLite database in ./data/app.db
# Production (Neon Serverless Postgres):
#   Use Pooled connection string (with -pooler) for application queries:
#   postgresql+psycopg2://<user>:<password>@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./data/app.db

# [OPTIONAL in dev, REQUIRED for migrations in prod]
# Direct connection (port 5432, without -pooler) for Alembic migrations & pg_dump:
#   postgresql+psycopg2://<user>:<password>@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
MIGRATION_DATABASE_URL=

# [OPTIONAL] Automatically execute 'alembic upgrade head' on startup (default: true)
RUN_MIGRATIONS_ON_START=true

# [OPTIONAL] Auto-create tables via Base.metadata.create_all (default: true for dev, false for prod with Alembic)
AUTO_CREATE_TABLES=true

# [OPTIONAL] Database connection pool parameters (tuned for Neon serverless scale-to-zero)
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=240
DB_POOL_PRE_PING=true


# ── File Storage Backend ─────────────────────────────────────────
# [OPTIONAL] Storage backend: "local" (disk), "db" (Neon Postgres bytea), or "s3"
# Local Development: local (files saved to UPLOAD_DIR)
# Production: db (stores PDF files directly in stored_files table; 100% stateless server)
STORAGE_BACKEND=local

# Local storage directory (used when STORAGE_BACKEND=local)
UPLOAD_DIR=./data/raw_pdfs

# Storage Quotas & Safety Caps (Megabytes)
MAX_UPLOAD_MB=30
USER_STORAGE_QUOTA_MB=100
GLOBAL_STORAGE_CAP_MB=400


# ── Vector Store Backend (pgvector / Chroma) ─────────────────────
# [OPTIONAL] Vector storage backend: "chroma" (local disk) or "pgvector" (Neon Postgres)
# Default: chroma for dev, pgvector for production
VECTOR_BACKEND=chroma

# ChromaDB persistence directory (used when VECTOR_BACKEND=chroma)
VECTOR_STORE_DIR=./data/vector_store
HNSW_EF_SEARCH=40


# ── Authentication & Security ────────────────────────────────────
# [REQUIRED in production] Random 256-bit secret key used to sign JWT tokens.
# Must be at least 32 characters in production.
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-string

# [OPTIONAL] JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# [OPTIONAL] Access token expiration in minutes (default: 60)
JWT_EXPIRE_MINUTES=60

# [OPTIONAL] Refresh token rotation expiration in days (default: 7)
JWT_REFRESH_EXPIRE_DAYS=7


# ── Networking & CORS ────────────────────────────────────────────
# [OPTIONAL] Allowed frontend origins for CORS (comma-separated list)
FRONTEND_ORIGIN=http://localhost:5173

# [OPTIONAL] Regex for dynamic frontend preview branches (e.g. Vercel previews)
FRONTEND_ORIGIN_REGEX=^https:\/\/studymate-.*\.vercel\.app$


# ── LLM Provider Configuration ───────────────────────────────────
# [OPTIONAL] LLM provider: "groq" (default, ultra-fast), "openai", or "ollama" (local)
LLM_PROVIDER=groq

# Groq API Configuration (required if LLM_PROVIDER=groq)
# Primary production model: openai/gpt-oss-120b
# Fallback model: openai/gpt-oss-20b (faster, lower cost)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI API Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b


# ── Embedding Model & Performance Tuning ─────────────────────────
# [OPTIONAL] HuggingFace sentence transformer embedding model (384-dimensional cosine)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pre-load embedding model weights into memory at startup
PREWARM_MODEL=true

# Restrict PyTorch thread count to keep memory bounded on Render 2GB Standard plan
TORCH_NUM_THREADS=2


# ── RAG Pipeline Tuning ──────────────────────────────────────────
# Chunking parameters
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval parameters
TOP_K=5
FETCH_K=10
USE_MMR=true
SCORE_THRESHOLD=0.05

# Cross-encoder reranker (optional)
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Generation tuning
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# Chat conversation history window (number of Q&A turns)
HISTORY_WINDOW=4

# Rate limiting rule (proxy and user aware)
RATE_LIMIT="30/minute"
