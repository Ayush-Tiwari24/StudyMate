# ─────────────────────────────────────────────────────────────────
# StudyMate AI — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and configure values for your environment.
# Values marked [REQUIRED] must be supplied before starting.
# Values marked [OPTIONAL] fall back to sensible defaults.
# NEVER commit your production .env file to source control!
# ─────────────────────────────────────────────────────────────────

# ── Application & Environment ────────────────────────────────────
# [OPTIONAL] Application display name
APP_NAME="StudyMate RAG"

# [OPTIONAL] Environment: "development" | "staging" | "production"
# In "production", startup guards reject SQLite, insecure JWT secrets, etc.
ENVIRONMENT=development

# [OPTIONAL] Debug mode (enables verbose errors; MUST be false in production)
DEBUG=false


# ── Database & Migrations ─────────────────────────────────────────
# [OPTIONAL] Database connection string.
# Local Development: SQLite database in ./data/app.db
# Production (Supabase Postgres):
#   Use Transaction Pooler (port 6543) for application queries:
#   postgresql+psycopg2://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./data/app.db

# [OPTIONAL in dev, RECOMMENDED in prod] Direct / Session connection for Alembic migrations:
#   Alembic DDL (indexes, table creations, extensions) should connect to Direct DB (port 5432) or Session Pooler:
#   postgresql+psycopg2://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=

# [OPTIONAL] Automatically execute 'alembic upgrade head' on container startup (default: true)
RUN_MIGRATIONS_ON_START=true

# [OPTIONAL] Auto-create tables via Base.metadata.create_all (default: true for dev, false for prod with Alembic)
AUTO_CREATE_TABLES=true

# [OPTIONAL] Database connection pool parameters (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true


# ── File Storage Driver (Supabase Storage / S3) ───────────────────
# [OPTIONAL] Storage backend driver: "local" (disk) or "s3" (Supabase Storage / AWS S3 / MinIO)
# Local: local disk inside container/host (lost on container restart)
# Production: s3
STORAGE_BACKEND=local

# Local storage directory (used when STORAGE_BACKEND=local)
UPLOAD_DIR=./data/raw_pdfs

# S3 / Supabase Storage Configuration (Used when STORAGE_BACKEND=s3)
# In Supabase: Create a private bucket in Storage (e.g., 'studymate-pdfs')
# Generate S3 Access Key & Secret Key in Supabase Dashboard -> Project Settings -> Storage -> S3 Credentials
S3_BUCKET=studymate-pdfs
S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Supabase Mumbai Region: ap-south-1
S3_REGION=ap-south-1


# ── Vector Store Backend (pgvector / Chroma) ─────────────────────
# [OPTIONAL] Vector storage backend: "chroma" (local disk) or "pgvector" (Supabase Postgres)
# Default: chroma for dev, pgvector for production
VECTOR_BACKEND=chroma

# ChromaDB persistence directory (used when VECTOR_BACKEND=chroma)
VECTOR_STORE_DIR=./data/vector_store

# Maximum PDF upload size in megabytes (default: 50MB)
MAX_UPLOAD_MB=50


# ── Authentication & Security ────────────────────────────────────
# [REQUIRED in production] Random 256-bit secret key used to sign JWT tokens.
# Must be at least 32 characters in production.
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-string

# [OPTIONAL] JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# [OPTIONAL] Access token expiration in minutes (default: 60)
JWT_EXPIRE_MINUTES=60

# [OPTIONAL] Refresh token rotation expiration in days (default: 7)
JWT_REFRESH_EXPIRE_DAYS=7


# ── Networking & CORS ────────────────────────────────────────────
# [OPTIONAL] Allowed frontend origins for CORS (comma-separated list)
FRONTEND_ORIGIN=http://localhost:5173

# [OPTIONAL] Regex for dynamic frontend preview branches (e.g. Vercel previews)
FRONTEND_ORIGIN_REGEX=^https:\/\/studymate-.*\.vercel\.app$


# ── LLM Provider Configuration ───────────────────────────────────
# [OPTIONAL] LLM provider: "groq" (default, ultra-fast), "openai", or "ollama" (local)
LLM_PROVIDER=groq

# Groq API Configuration (required if LLM_PROVIDER=groq)
# Primary production model: openai/gpt-oss-120b
# Fallback model: openai/gpt-oss-20b (faster, lower cost)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI API Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b


# ── Embedding Model & Performance Tuning ─────────────────────────
# [OPTIONAL] HuggingFace sentence transformer embedding model (384-dimensional cosine)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pre-load embedding model weights into memory at startup
PREWARM_MODEL=true

# Restrict PyTorch thread count to keep memory bounded on Render 2GB Standard plan
TORCH_NUM_THREADS=2


# ── RAG Pipeline Tuning ──────────────────────────────────────────
# Chunking parameters
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval parameters
TOP_K=5
FETCH_K=10
USE_MMR=true
SCORE_THRESHOLD=0.05

# Cross-encoder reranker (optional)
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Generation tuning
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# Chat conversation history window (number of Q&A turns)
HISTORY_WINDOW=4

# Rate limiting rule (proxy and user aware)
RATE_LIMIT="30/minute"
