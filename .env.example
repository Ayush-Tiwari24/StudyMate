# ─────────────────────────────────────────────────────────────────
# StudyMate RAG — Environment Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and configure values for your environment.
# Values marked [REQUIRED] must be supplied before starting.
# Values marked [OPTIONAL] fall back to sensible defaults.
# NEVER commit your production .env file to source control!
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
# [OPTIONAL] Application display name
APP_NAME="StudyMate RAG"

# [OPTIONAL] Debug mode (enables verbose errors; MUST be false in production)
DEBUG=false

# ── Database & Migrations ─────────────────────────────────────────
# [OPTIONAL] Database connection string.
# Default: Local SQLite database in ./data/app.db
# Production: postgresql+psycopg2://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# [OPTIONAL] Auto-create tables on startup (default: true for dev, false for production with Alembic)
AUTO_CREATE_TABLES=true

# [OPTIONAL] Database connection pool parameters (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ── File Storage Driver ──────────────────────────────────────────
# [OPTIONAL] Storage backend driver: "local" (disk) or "s3" (AWS S3 / MinIO / Cloudflare R2)
# Default: local
STORAGE_BACKEND=local

# [OPTIONAL] Local directory for storing raw uploaded PDFs (used when STORAGE_BACKEND=local)
UPLOAD_DIR=./data/raw_pdfs

# S3 Storage Configuration (Used when STORAGE_BACKEND=s3)
# [REQUIRED if STORAGE_BACKEND=s3] S3 bucket name
S3_BUCKET=my-studymate-bucket

# [OPTIONAL] Custom endpoint URL (for MinIO e.g. http://localhost:9000 or LocalStack)
S3_ENDPOINT_URL=

# [REQUIRED if STORAGE_BACKEND=s3] AWS / S3 access credentials
S3_ACCESS_KEY=
S3_SECRET_KEY=

# [OPTIONAL] AWS region (default: us-east-1)
S3_REGION=us-east-1

# ── Vector Store Backend ─────────────────────────────────────────
# [OPTIONAL] Vector storage backend: "chroma" or "pgvector"
# Default: chroma
VECTOR_BACKEND=chroma

# [OPTIONAL] Local persistence directory for ChromaDB (used when VECTOR_BACKEND=chroma)
VECTOR_STORE_DIR=./data/vector_store

# [OPTIONAL] Maximum PDF file upload size in megabytes (default: 50MB)
MAX_UPLOAD_MB=50

# ── Authentication & Security ────────────────────────────────────
# [REQUIRED in production] Random 256-bit secret key used to sign JWT tokens.
# Startup will fail in production if left as the default placeholder!
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-string

# [OPTIONAL] JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# [OPTIONAL] Access token expiration in minutes (default: 60)
JWT_EXPIRE_MINUTES=60

# [OPTIONAL] Refresh token rotation expiration in days (default: 7)
JWT_REFRESH_EXPIRE_DAYS=7

# ── Networking & CORS ────────────────────────────────────────────
# [OPTIONAL] Allowed frontend origin for CORS headers (default: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# ── LLM Provider Configuration ───────────────────────────────────
# [OPTIONAL] LLM provider: "groq" (default, ultra-fast), "openai", or "ollama" (local)
LLM_PROVIDER=groq

# Groq API Configuration (required if LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI API Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Embedding Model ──────────────────────────────────────────────
# [OPTIONAL] HuggingFace sentence transformer embedding model (384-dimensional cosine)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG Pipeline Tuning ──────────────────────────────────────────
# [OPTIONAL] Chunking parameters
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# [OPTIONAL] Retrieval parameters
TOP_K=5
FETCH_K=10
USE_MMR=true
# Minimum cosine similarity threshold for retrieved passages (0.00 to 1.00)
SCORE_THRESHOLD=0.05

# [OPTIONAL] Cross-encoder reranker
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# [OPTIONAL] Generation tuning
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# [OPTIONAL] Chat conversation history window (number of Q&A turns)
HISTORY_WINDOW=4

# [OPTIONAL] Rate limiting rule
RATE_LIMIT="30/minute"
