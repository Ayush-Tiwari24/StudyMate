# StudyMate AI — Frontend Environment Variables
# In local development: points to local FastAPI backend
VITE_API_URL=http://localhost:8000

# Set to true only if developing frontend without a running backend
VITE_USE_MOCK=false

# For production deployment on Vercel:
# Set VITE_API_URL in the Vercel project dashboard to your Render backend URL:
# VITE_API_URL=https://studymate-api.onrender.com
